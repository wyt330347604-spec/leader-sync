{
  "name": "leader-sync",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:generate": "pnpm --filter @leader-sync/db generate",
    "db:migrate": "pnpm --filter @leader-sync/db migrate",
    "db:seed": "pnpm --filter @leader-sync/db seed",
    "server:dev:up": "bash scripts/server-dev-up.sh",
    "dev:tunnel": "bash scripts/dev-tunnel.sh up",
    "dev:tunnel:down": "bash scripts/dev-tunnel.sh down",
    "dev:tunnel:status": "bash scripts/dev-tunnel.sh status",
    "dev:up": "bash scripts/dev-up.sh",
    "dev:reset": "bash scripts/dev-reset.sh",
    "dev:seed": "bash scripts/dev-seed.sh",
    "logs:pull": "bash scripts/pull-logs.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "turbo": "^2.8.19",
    "typescript": "^5.9.3"
  }
}
