FROM node:22-slim AS base
RUN npm install -g pnpm@10
WORKDIR /app

# ── Dependencies ──
FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/domain-core/package.json packages/domain-core/
COPY db/package.json db/
RUN pnpm install --frozen-lockfile

# ── Build ──
FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/shared-types/ packages/shared-types/
COPY packages/domain-core/ packages/domain-core/
COPY db/ db/
COPY apps/api/ apps/api/

# Build workspace packages as CommonJS (NestJS compatibility)
RUN pnpm --filter @leader-sync/shared-types exec tsc --outDir dist --rootDir src --declaration --module commonjs --moduleResolution node --esModuleInterop true \
 && pnpm --filter @leader-sync/domain-core exec tsc --outDir dist --rootDir src --declaration --module commonjs --moduleResolution node --esModuleInterop true \
 && cd db && npx tsc -p tsconfig.build.json --module commonjs --moduleResolution node --esModuleInterop true && cd .. \
 && pnpm --filter @leader-sync/api build

# ── Production ──
FROM base AS production
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=build /app/packages/shared-types/dist ./packages/shared-types/dist
COPY --from=build /app/packages/shared-types/package.json ./packages/shared-types/
COPY --from=build /app/packages/domain-core/dist ./packages/domain-core/dist
COPY --from=build /app/packages/domain-core/package.json ./packages/domain-core/
COPY --from=build /app/db/dist ./db/dist
COPY --from=build /app/db/package.json ./db/
COPY --from=build /app/apps/api/dist ./apps/api/dist

EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
